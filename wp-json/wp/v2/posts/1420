28 \u0643\u0644\u0651\u0627. \u0625\u0646 \u0625\u062c\u062a \u0648\u062d\u062f\u0629 \u0648\u062d\u062f\u0629&#8230; \u0623\u0648 \u0645\u0639 \u0628\u0639\u0636\u0627.<\/p>\n<p dir=\"rtl\">\u0625\u0633\u0645\u064a&#8230;. \u0633\u0627\u0643\u0646\u0629 \u0628\u0645\u0646\u0637\u0642\u0629&#8230;<span class=\"Apple-converted-space\">\u00a0<\/span><\/p>\n<p dir=\"rtl\">\u0643\u0627\u0646\u062a \u0625\u064a\u0651\u0627\u0645 \u062d\u0631\u0628 \u0648\u0636\u0631\u0628\u060c \u0648\u0643\u0646\u0651\u0627 \u0639\u0627\u064a\u0634\u064a\u0646 \u0643\u0644\u0651 \u064a\u0648\u0645 \u0628\u064a\u0648\u0645\u064f\u0647\u060c \u0642\u0635\u0641 \u0648\u0642\u0630\u0627\u064a\u0641 \u0648\u0636\u0631\u0628 \u0648\u0645\u0644\u0627\u062c\u0626. \u0643\u0627\u0646 \u0639\u0646\u062f\u064a \u062a\u0644\u0627\u062a \u0648\u0644\u0627\u062f \u0635\u063a\u0627\u0631\u060c \u0625\u062d\u0645\u0644\u064f\u0646 \u0648\u0625\u062d\u0645\u0644\u064f\u0651\u0646 \u063a\u0631\u0627\u0636\u064f\u0646 \u0648\u0646\u0632\u0651\u0644\u064f\u0646 \u0639\u0627\u0644\u0645\u0644\u062c\u0623. \u0648\u0628\u0633 \u064a\u062e\u0644\u0635 \u0627\u0644\u0642\u0635\u0641 \u0646\u0631\u062c\u0639 \u0646\u0637\u0644\u0639.<\/p>\n<p dir=\"rtl\">\u0648\u0641\u064a \u0646\u0647\u0627\u0631\u060c \u062d\u0633\u0651\u064a\u062a \u0628\u0634\u064a \u0645\u0634 \u0637\u0628\u064a\u0639\u064a \u0628\u0635\u062f\u0631\u064a\u060c \u0641\u0631\u062d\u062a \u0639\u0646\u062f \u0627\u0644\u062d\u0643\u064a\u0645 \u0648\u0627\u0643\u062a\u0634\u0641\u062a \u0625\u0646\u0651\u0647 \u0645\u0631\u0636 \u062e\u0628\u064a\u062b \u0648\u0644\u0627\u0632\u0645\u064f\u0647 \u0639\u0645\u0644\u064a\u0629 \u0648\u0639\u0644\u0627\u062c. \u0648\u0647\u0648\u0646 \u0628\u0644\u0651\u0634\u062a \u0639\u064a\u0634 \u062d\u064a\u0627\u0629 \u062e\u0648\u0641 \u0648\u0631\u0639\u0628\u060c \u0644\u0623\u0646\u0651\u0647 \u0645\u0646 \u0645\u064a\u0644\u0629 \u0639\u0646\u062f\u064a \u062a\u0644\u0627\u062a \u0648\u0644\u0627\u062f \u0635\u063a\u0627\u0631\u060c \u0648\u0645\u0646 \u0645\u064a\u0644\u0629 \u062d\u0631\u0628 \u0648\u0636\u0631\u0628. \u0648\u0635\u0631\u062a \u0641\u0643\u0651\u0631 \u0625\u0630\u0627 \u0635\u0631\u0644\u064a \u0634\u064a \u0634\u0648 \u0628\u062f\u064f\u0651\u0646 \u064a\u0639\u0645\u0644\u0648\u0627 \u0644\u062d\u0627\u0644\u064f\u0646 \u0628\u0644\u0627 \u0625\u0645 \u0628\u0647\u0627\u0644\u0623\u0648\u0636\u0627\u0639 \u0627\u0644\u0635\u0639\u0628\u0629 \u0648\u0627\u0644\u062e\u0637\u0631\u0629\u060c \u0648\u0643\u064a\u0641 \u0628\u062f\u064f\u0651\u0646 \u064a\u0639\u064a\u0634\u0648\u0627.<\/p>\n<p dir=\"rtl\">\u0645\u0646 \u0628\u0639\u062f \u0645\u0627 \u0628\u0643\u064a\u062a \u0643\u062a\u064a\u0631\u060c \u0641\u0643\u0651\u0631\u062a \u0625\u0646\u0651\u0647 \u0627\u0644\u062e\u0648\u0641 \u0648\u0627\u0644\u0628\u0643\u064a \u0645\u0627 \u0631\u062d \u064a\u0639\u0645\u0644\u0648\u0644\u064a \u0634\u064a\u060c \u0648\u0644\u0627 \u0631\u062d \u064a\u0634\u0641\u0648\u0646\u064a\u060c \u0648\u0644\u0627 \u0631\u062d \u064a\u0633\u0627\u0639\u062f\u0648\u0646\u064a. \u0642\u0631\u0651\u0631\u062a \u0643\u0648\u0646 \u0642\u0648\u064a\u0651\u0629 \u0643\u062a\u064a\u0631 \u0644\u0625\u062a\u062e\u0637\u0651\u0649 \u0647\u0627\u0644\u0645\u0631\u0636\u060c \u0648\u0625\u0631\u062c\u0639 \u0644\u0648\u0644\u0627\u062f\u064a \u0648\u0639\u064a\u0644\u062a\u064a. \u0642\u0648\u0651\u064a\u062a \u0625\u064a\u0645\u0627\u0646\u064a \u0628\u0627\u0644\u0644\u0647\u060c \u0648\u062d\u0637\u0651\u064a\u062a \u0628\u0631\u0627\u0633\u064a \u0625\u0646\u0651\u064a \u0628\u062f\u0651\u064a \u0643\u0648\u0646 \u0623\u0642\u0648\u0649 \u0645\u0646 \u0627\u0644\u0645\u0631\u0636 \u0648\u0628\u062f\u0651\u064a \u0625\u063a\u0644\u0628\u064f\u0647 \u0644\u0625\u0631\u062c\u0639 \u0644\u0648\u0644\u0627\u062f\u064a. \u0631\u062d\u062a \u0639\u0646\u062f \u0627\u0644\u062d\u0643\u064a\u0645 \u0648\u0628\u0644\u0651\u0634\u062a \u0628\u0627\u0644\u0639\u0644\u0627\