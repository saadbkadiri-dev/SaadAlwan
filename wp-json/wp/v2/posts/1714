42\u0639\u062f \u0628\u0627\u0644\u0645\u0644\u0627\u062c\u0626 \u0648\u0646\u0646\u0637\u0631 \u062a\u0627 \u064a\u062e\u0641\u0651 \u0627\u0644\u0642\u0635\u0641 \u0644\u0646\u0631\u0648\u062d \u0639\u0627\u0644\u0641\u0631\u0646 \u0648\u0646\u062c\u064a\u0628 \u0631\u0628\u0637\u0629 \u062e\u0628\u0632 \u0644\u0644\u0648\u0644\u0627\u062f\u060c \u0623\u0648 \u062a\u0627 \u0646\u062c\u064a\u0628 \u0645\u064a\u0651.<\/p>\n<p dir=\"rtl\">\u0643\u0646\u062a \u0636\u0644 \u0635\u0644\u0651\u064a\u060c \u0644\u0645\u0627 \u062c\u0648\u0632\u064a \u0648\u0642\u0651\u0641 \u0634\u063a\u0644\u064f\u0647\u060c \u0628\u0639\u062a \u062a\u0627 \u0646\u0642\u062f\u0631 \u0646\u0639\u064a\u0634 \u0635\u064a\u063a\u0629 \u0648\u062f\u0647\u0628 \u0643\u0627\u0646\u0648\u0627 \u0639\u0646\u062f\u064a\u060c \u0644\u0623\u0646 \u0639\u064a\u0644\u062a\u0646\u0627 \u0637\u0648\u064a\u0644\u0629 \u0639\u0631\u064a\u0636\u0629\u060c \u0648\u0645\u0627 \u0628\u062f\u0646\u0627 \u0646\u062d\u0633\u0651\u0633\u064f\u0646 \u0628\u0627\u0644\u0642\u0644\u0651\u0629. \u0648\u0643\u0645\u0627\u0646\u060c \u0633\u0643\u0651\u0631\u062a \u0627\u0644\u0645\u062f\u0627\u0631\u0633\u060c \u0648\u0645\u0627 \u062a\u0639\u0644\u0651\u0645\u0648\u0627 \u0627\u0644\u0648\u0644\u0627\u062f \u0648\u0642\u062a \u0627\u0644\u062d\u0631\u0628.<\/p>\n<p dir=\"rtl\">\u0645\u0646 \u0639\u064a\u0644\u062a\u064a\u060c \u0645\u0627 \u062d\u062f\u0627 \u0645\u0627\u062a \u0628\u0627\u0644\u062d\u0631\u0628 \u0627\u0644\u062d\u0645\u062f\u0644\u0644\u0647\u060c \u0628\u0633 \u0628\u0646\u062a \u062d\u0645\u0627\u064a\u064a \u062a\u0648\u0641\u0651\u062a \u0628\u0627\u0644\u062d\u0631\u0628. \u0646\u062d\u0646\u0627 \u0645\u0627 \u062e\u0633\u0631\u0646\u0627 \u0646\u0627\u0633\u060c \u0628\u0633 \u0645\u0627\u062f\u0651\u064a\u064b\u0651\u0627 \u062a\u0623\u062b\u0651\u0631\u0646\u0627\u060c \u0628\u0630\u0643\u0631 \u0645\u0631\u0651\u0629 \u0625\u062c\u062a \u0642\u0630\u064a\u0641\u0629 \u0639\u0627 \u0633\u0