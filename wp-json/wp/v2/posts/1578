0644\u0636\u064a\u0642\u0629 \u0648\u0627\u0644\u0645\u0643\u0631\u0648\u0647.<\/p>\n<p dir=\"rtl\">\u0625\u0633\u0645\u064a \u0633\u0639\u0627\u062f \u0623\u0628\u064a \u0631\u0627\u0634\u062f\u060c \u0639\u0645\u0631\u064a 68 \u0633\u0646\u0629. \u0631\u062d \u062e\u0628\u0651\u0631 \u0642\u0635\u0651\u0629 \u0645\u0646 \u062d\u064a\u0627\u062a\u064a\u060c \u0628\u0648\u0642\u062a \u0643\u0627\u0646 \u0644\u0628\u0646\u0627\u0646 \u0643\u0644\u064f\u0651\u0647 \u0645\u0634\u062a\u0639\u0644.<\/p>\n<p dir=\"rtl\">\u0623\u0648\u0651\u0644 \u0627\u0644\u062d\u0631\u0628 \u0633\u0646\u0629 1976\u060c \u0643\u0627\u0646 \u0641\u064a \u0645\u0639\u0627\u0631\u0643 \u0628\u064a\u0646 \u0627\u0644\u0641\u0644\u0633\u0637\u064a\u0646\u064a\u0651\u0629 \u0648\u0627\u0644\u0643\u062a\u0627\u064a\u0628\u060c \u0641\u0627 \u0642\u062a\u0644\u0648\u0627 \u062c\u0648\u0632\u064a \u0643\u0627\u0646 \u0639\u0645\u0631\u064a \u0648\u0642\u062a\u0627 31 \u0633\u0646\u0629\u060c \u0648\u0643\u0627\u0646 \u0639\u0646\u062f\u064a \u062a\u0644\u0627\u062a \u0628\u0646\u0627\u062a\u060c \u0627\u0644\u0632\u063a\u064a\u0631\u0629 \u0639\u0645\u0631\u0627 9 \u0623\u0634\u0647\u0631.<\/p>\n<p dir=\"rtl\">\u0623\u0648\u0651\u0644 \u0634\u064a \u0644\u0645\u0627 \u0641\u0627\u062a\u0648\u0627 \u0627\u0644\u0633\u0648\u0631\u064a\u0651\u064a\u0646\u060c \u0647\u0631\u0628\u0646\u0627 \u0645\u0646 \u0628\u064a\u0631\u0648\u062a\u060c \u0637\u0644\u0639\u062a \u0639\u0646\u062f \u0623\u0647\u0644\u064a \u0633\u0646\u062a\u064a\u0646\u060c \u0623\u0647\u0644\u064a \u0643\u0627\u0646\u0648\u0627 \u0628\u0645\u0646\u0637\u0642\u0629 \u0639\u0627\u0644\u064a\u0647. \u0631\u062c\u0639\u062a \u0639\u0627\u0644\u0628\u064a\u062a \u0633\u0646\u0629 \u0627\u0644\u062a\u0645\u0627\u0646\u064a\u0646\u060c \u0631\u062c\u0639\u062a \u0644\u0642\u064a\u062a \u0627\u0644\u0628\u064a\u062a \u0645\u0633\u0631\u0648\u0642\u060c \u0627\u0644\u0633\u0648\u0631\u064a\u064a\u0646 \u0646\u0627\u0647\u0628\u064a\u0646 